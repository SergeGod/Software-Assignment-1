# Copy to .env (git-ignored) before `docker compose up`, and change the values.
# Local only: Azure gets its passwords from GitHub Actions secrets.
# SQL Server rejects weak passwords (8+ characters, upper, lower, digit or symbol).
# Use letters, digits and _ only, because they also go inside a URL.
SA_PASSWORD=Change_me_Sa_1
LEDGER_DB_PASSWORD=Change_me_Ledger_1
SETTLEMENT_DB_PASSWORD=Change_me_Settlement_1
